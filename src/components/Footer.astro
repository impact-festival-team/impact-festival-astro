---
// Footer.astro — static, same on every page.
const columns = [
  { heading: '2026 Program', links: ['Full program', 'Music', 'Talks', 'Workshops'] },
  { heading: 'About', links: ['Think global, act global', 'Partners', 'Contact'] },
  { heading: '2025', links: ['Archive', 'Speakers'] },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="brand">
      <div class="logo-block">
        <img src="/images/logo-grey.svg" alt="Impact Festival" class="logo" />
        <p class="org-text">Organized by Forening Impact,<br />Sydhavnen.</p>
      </div>
      <div class="socials">
        <img src="/images/instagram.svg" alt="Instagram" />
        <img src="/images/facebook.svg" alt="Facebook" />
        <img src="/images/linkedin.svg" alt="LinkedIn" />
      </div>
    </div>

    <div class="nav-columns">
      {columns.map((col) => (
        <nav class="nav-column">
          <p class="col-heading">{col.heading}</p>
          {col.links.map((link) => (
            <p class="col-link">{link}</p>
          ))}
        </nav>
      ))}
    </div>
  </div>

  <div class="logo-banner">
    <img src="/images/impact-logo.svg" alt="" class="banner-logo-1" />
    <img src="/images/logo-fstvl.svg" alt="" class="banner-logo-2" />
  </div>
</footer>

<style>
  .footer {
    background: var(--color-white);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .footer-inner {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    padding: 80px 24px;
    width: 100%;
    max-width: 1392px;
    box-sizing: border-box;
  }

  .brand {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 56px;
  }

  .logo-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .logo {
    height: 16px;
  }

  .org-text {
    font-size: 16px;
    color: var(--color-grey);
  }

  .socials {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .socials img {
    width: 24px;
    height: 24px;
  }

  .nav-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .nav-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 130px;
  }

  .col-heading {
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.48px;
    padding-bottom: 16px;
  }

  .col-link {
    font-size: 16px;
    color: var(--color-grey);
  }

  .logo-banner {
    background: var(--color-red);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 188px;
    width: 100%;
    max-width: 1392px;
    box-sizing: border-box;
    padding: 24px;
  }

  .banner-logo-1 {
    height: 153px;
  }

  .banner-logo-2 {
    height: 151px;
  }

  @media (max-width: 900px) {
    .footer-inner {
      flex-direction: column;
      gap: 48px;
    }

    .nav-columns {
      gap: 48px;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 640px) {
    .logo-banner {
      height: auto;
      padding: 24px;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
    }

    .banner-logo-1,
    .banner-logo-2 {
      height: 80px;
    }
  }
</style>
