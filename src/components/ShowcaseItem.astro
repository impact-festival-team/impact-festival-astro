---
// ShowcaseItem.astro

// x 3 times med forskellige props.

const { image, title, caption } = Astro.props;
---

<div class="showcase-item">
  <div class="showcase-photo">
    <img src={image} alt={title} />
  </div>
  <h4 class="showcase-title">{title}</h4>
  <p class="showcase-caption">{caption}</p>
</div>

<style>
  .showcase-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1 1 260px;
  }

  .showcase-photo {
    background: white;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .showcase-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-title {
    font-weight: 700;
    font-size: 18px;
  }

  .showcase-caption {
    font-size: 15px;
    color: var(--color-grey);
    line-height: 1.4;
  }
</style>
