---
// ScheduleItem.astro
 //x6

const { title, description, image, time, category } = Astro.props;
---

<div class="item">
  <div class="text">
    <h4 class="title">{title}</h4>
    <p class="description">{description}</p>
  </div>

  <div class="photo">
    <img src={image} alt={title} />
  </div>

  <div class="timing">
    <h4 class="time">{time}</h4>
    <p class="category">{category}</p>
  </div>
</div>

<style>
  .item {
    border-bottom: 1px solid var(--color-grey);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    width: 100%;
    box-sizing: border-box;
    gap: 24px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 2 1 320px;
  }

  .title {
    font-weight: 700;
    font-size: 20px;
    text-transform: capitalize;
  }

  .description {
    font-size: 16px;
    line-height: 1.4;
  }

  .photo {
    background: white;
    height: 168px;
    width: 320px;
    flex: 1 1 240px;
    max-width: 320px;
    overflow: hidden;
    flex-shrink: 1;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1 1 200px;
    max-width: 366px;
    white-space: nowrap;
    gap: 16px;
  }

  .time {
    font-weight: 700;
    font-size: 20px;
  }

  .category {
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.72px;
  }

  @media (max-width: 900px) {
    .item {
      flex-wrap: wrap;
    }

    .photo {
      width: 240px;
      height: 126px;
    }
  }

  @media (max-width: 640px) {
    .item {
      flex-direction: column;
      align-items: flex-start;
    }

    .text {
      max-width: 100%;
    }

    .photo {
      width: 100%;
      height: 200px;
    }

    .timing {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
