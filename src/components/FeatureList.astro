---
// FeatureList.astro


import FeatureRow from './FeatureRow.astro';

const { image, features } = Astro.props;
---

<section class="feature-list">
  <div class="photo">
    <img src={image} alt="Trifolium building" />
  </div>

  <div class="rows">
    {features.map((feature) => <FeatureRow {...feature} />)}
  </div>
</section>

<style>
.feature-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    width: 100%;
    align-items: stretch; 

  .photo {
    flex: 1 1 500px; 
    min-height: 100%;
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rows {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Spreads rows edge-to-edge without extra outer padding */
  }
</style>
