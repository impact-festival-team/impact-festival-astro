---
// FeatureList.astro
// Building photo on the left, stacked FeatureRow list on the right.
// This is the homepage's own version — different content than the
// /trifolium subpage's FeatureRow usage, same component, reused with
// different props (that's the point of building it as props-driven).

import FeatureRow from './FeatureRow.astro';

interface Feature {
  title: string;
  description: string;
}

interface Props {
  image: string;
  features: Feature[];
}

const { image, features } = Astro.props;
---

<section class="feature-list">
  <div class="photo">
    <img src={image} alt="Trifolium building" />
  </div>

  <div class="rows">
    {features.map((feature) => <FeatureRow {...feature} />)}
  </div>
</section>

<style>
  .feature-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    width: 100%;
  }

  .photo {
    flex: 1 1 400px;
    min-height: 320px;
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 320px;
  }

  .rows {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
