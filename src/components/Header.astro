---
// Header.astro — grid layout for true optical centering of the logo.
---

<header class="header">
  <!-- Left Side: 2 Links -->
  <nav class="nav-left">
    <a href="/program" class="nav-link">program</a>
    <a href="/about" class="nav-link">about</a>
  </nav>

  <!-- Center: Logo -->
  <a href="/" aria-label="Impact Festival home" class="logo-link">
    <img src="/images/logo.svg" alt="Impact Festival" class="logo" />
  </a>

  <!-- Right Side: 2 Links + Ticket Button -->
  <div class="nav-right">
    <a href="/trifolium" class="nav-link">trifolium</a>
    <a href="/location" class="nav-link">location</a>
    <a href="/tickets" class="ticket-btn">Get ticket</a>
  </div>
</header>

<style>
  .header {
    background: var(--color-white);
    display: grid;
    /* 3-column layout: Left and Right get equal width (1fr), Center shrinks to logo width (auto) */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 24px;
    width: 100%;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    min-width: 0;
  }

  .logo-link {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 24px; /* Space around the logo */
  }

  .logo {
    height: 32px;
    width: auto;
  }

  .nav-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    min-width: 0;
  }

  .nav-link {
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.48px;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .ticket-btn {
    background: var(--color-red);
    color: white;
    font-weight: 500;
    font-size: 18px;
    padding: 12px 16px;
    border-radius: 2px;
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Responsive spacing */
  @media (max-width: 900px) {
    .nav-left,
    .nav-right {
      gap: 16px;
    }
    .nav-link {
      font-size: 12px;
    }
  }

  @media (max-width: 640px) {
    .header {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
