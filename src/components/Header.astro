---
// Header.astro 
---

<header class="header">
  <!-- Left Side: 2 Links -->
  <nav class="nav-left">
    <a href="/program" class="nav-link">program</a>
    <a href="/about" class="nav-link">about</a>
  </nav>

  <!-- Center: Logo -->
  <a href="/" aria-label="Impact Festival home" class="logo-link">
    <img src="/images/logo.svg" alt="Impact Festival" class="logo" />
  </a>

  <!-- Right Side: 2 Links + Ticket Button -->
  <div class="nav-right">
    <a href="/trifolium" class="nav-link">trifolium</a>
    <a href="/location" class="nav-link">location</a>
    <a href="/tickets" class="ticket-btn">Get ticket</a>
  </div>
</header>

<style>
  .header {
    background: var(--color-white);
    display: grid;
    /* Forces true 3-column optical centering */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding: 16px 24px;
    width: 100%;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-left {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 32px;
  }

  .logo-link {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 16px;
  }

  .logo {
    height: 32px;
    width: auto;
    display: block;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px; 
  }

  .nav-link {
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.48px;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .ticket-btn {
    background: var(--color-red);
    color: white;
    font-weight: 500;
    font-size: 18px;
    padding: 10px 16px;
    border-radius: 2px;
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
    margin-left: 8px;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .nav-left,
    .nav-right {
      gap: 16px;
    }
    .nav-link {
      font-size: 12px;
    }
  }

 /* Mobile single-column layout */
  @media (max-width: 640px) {
    .header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 16px;
    }

   
    .nav-left,
    .nav-right {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      gap: 12px;
    }

    .logo-link {
      padding: 0;
      order: -1; 
    }

    .ticket-btn {
      margin-left: 0; 
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>
